APP_NAME=GCP Helper
DATABASE_URL=sqlite:////app/data/gcp_helper.db
GCLOUD_BASE_DIR=/app/data/gcloud-envs
LOGIN_TIMEOUT_SECONDS=900
MAX_CONCURRENT_LOGINS=5
MAX_CONCURRENT_BOOTSTRAP_TASKS=2

# 使用 `openssl rand -base64 48` 生成。部署后必须保持不变，否则加密数据无法解密。
APP_SECRET_KEY=replace-with-a-long-random-secret

# 直接通过 http://IP:8080 访问时设为 false；配置 HTTPS 反向代理后必须改为 true。
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=12
AUTH_SESSION_COOKIE_NAME=gcph_session
AUTH_CSRF_COOKIE_NAME=gcph_csrf

GCLOUD_AUTH_BROWSER_FLAG=--no-launch-browser
LOG_LEVEL=INFO
LOG_FILE=/app/data/logs/app.log
SOCKS5_STARTUP_SCRIPT_PATH=/app/script/socks5.sh

COMPUTE_VM_ZONE=us-west2-a
COMPUTE_VM_MACHINE_TYPE=e2-micro
COMPUTE_VM_IMAGE_FAMILY=debian-12
COMPUTE_VM_IMAGE_PROJECT=debian-cloud
COMPUTE_VM_BOOT_DISK_SIZE=10GB
COMPUTE_VM_BOOT_DISK_TYPE=pd-standard
COMPUTE_VM_NETWORK_NAME=gcp-helper-network
COMPUTE_VM_NETWORK_TAG=socks5-server
COMPUTE_API_PROPAGATION_WAIT_SECONDS=10
SERVICE_ACCOUNT_KEY_POLICY_WAIT_SECONDS=180
ORG_POLICY_ADMIN_ROLE_WAIT_SECONDS=5
ORG_POLICY_API_PROPAGATION_WAIT_SECONDS=10
AGENT_PLATFORM_IAM_PROPAGATION_WAIT_SECONDS=10

NEW_API_CHANNEL_TEMPLATE_DIR=/app/data/channel-templates
NEW_API_CHANNEL_DEFAULT_TEMPLATE=default
NEW_API_CHANNEL_STATS_GROUP=Gemini_Vertex_Pro
NEW_API_CHANNEL_BUDGET_AMOUNT=300
NEW_API_QUOTA_PER_UNIT=500000
NEW_API_CURRENCY=USD
NEW_API_CHANNEL_STATS_CACHE_SECONDS=30
NEW_API_CHANNEL_STATS_PAGE_SIZE=100
NEW_API_CHANNEL_STATS_MAX_PAGES=100

# BASE_URL/TOKEN 仅用于旧版上传连接；下方模板及模型默认值也用于统一后台。
NEW_API_UPLOAD_BASE_URL=
NEW_API_UPLOAD_TOKEN=
NEW_API_UPLOAD_MODELS=gemini-2.5-flash
NEW_API_UPLOAD_GROUP=default
NEW_API_UPLOAD_VERTEX_REGION=global
# 可选：channel-templates 目录中的模板名称（不含 .json）。
# Vertex 留空时使用 NEW_API_CHANNEL_DEFAULT_TEMPLATE（默认 default）。
NEW_API_UPLOAD_VERTEX_TEMPLATE=
NEW_API_UPLOAD_GEMINI_TEMPLATE=
CHANNEL_UPLOAD_SYNC_SECONDS=120
CHANNEL_UPLOAD_SNAPSHOT_DAYS=30

ALLOWED_CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
